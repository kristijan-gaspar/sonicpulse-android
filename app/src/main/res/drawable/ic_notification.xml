<!--
    Monochrome notification small icon (a simple soundwave/pulse glyph, matching "SonicPulse").
    Per Android's status-bar icon guidelines: a plain white silhouette on a transparent
    background — the system itself renders it as a flat single color wherever it's actually
    shown (status bar, lock screen, etc.), so this drawable's own fillColor is never seen as-is.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M1,8h2v8h-2z M6,5h2v14h-2z M11,2h2v20h-2z M16,5h2v14h-2z M21,8h2v8h-2z" />
</vector>
